DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-for-local-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set DB_ENGINE=postgresql to use PostgreSQL; SQLite is the development default.
DB_ENGINE=sqlite
DB_NAME=nexus_sync
DB_USER=nexus_sync
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=5432

# SasuSync SMS. Use an API key and an approved sender ID from the portal.
SASUSYNC_API_KEY=
SASUSYNC_SENDER_ID=NexusSync
SASUSYNC_BASE_URL=https://sms.sasusync.com
# Set a webhook URL in the SasuSync API-key settings and store its signing secret here.
SASUSYNC_WEBHOOK_SECRET=

# Google Routes API. Enable Routes API and billing before configuring a server-side key.
GOOGLE_MAPS_API_KEY=

# Face research enrollment stays disabled unless a reviewed consent notice version
# and a Fernet encryption key are provisioned as backend secrets.
BIOMETRIC_RESEARCH_CONSENT_VERSION=
BIOMETRIC_SAMPLE_ENCRYPTION_KEY=
BIOMETRIC_RESEARCH_ENABLED=false
BIOMETRIC_VERIFIER_CLASS=

# Optional face + password sign-in experiment. Keep disabled outside local DEBUG.
# Configure a separate Fernet key and the same consent version in frontend/admin/.env.local.
BIOMETRIC_FACE_LOGIN_ENABLED=false
BIOMETRIC_FACE_CONSENT_VERSION=
BIOMETRIC_FACE_ENCRYPTION_KEY=
BIOMETRIC_MODEL_NAME=buffalo_l
BIOMETRIC_MODEL_ROOT=.face-model-cache
BIOMETRIC_MATCH_THRESHOLD=0.45
BIOMETRIC_FACE_LIVENESS_ENABLED=false
BIOMETRIC_LIVENESS_THRESHOLD=0.8

# Local, opt-in patient/caretaker motion-check evaluation; does not authenticate or retain frames.
BIOMETRIC_MOTION_TEST_ENABLED=false
BIOMETRIC_MOTION_CONSENT_VERSION=
